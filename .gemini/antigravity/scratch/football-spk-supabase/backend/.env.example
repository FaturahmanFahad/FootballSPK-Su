# Server
PORT=5000
NODE_ENV=development

# Supabase Credentials
# Dapatkan dari: Dashboard Supabase → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# JWT untuk autentikasi custom (bukan Supabase Auth)
JWT_SECRET=spk_football_jwt_super_secret_ganti_ini_2024
JWT_EXPIRES_IN=8h

# CORS Origin — * untuk semua, atau spesifik untuk Live Server
# CORS_ORIGIN=http://127.0.0.1:5500
CORS_ORIGIN=*
